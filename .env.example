# ==========================================
# CẤU HÌNH BOT TELEGRAM CÔNG TY
# ==========================================

# 1. Token bot lấy từ @BotFather trên Telegram (Bắt buộc)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_EXAMPLE

# 2. Telegram ID của Sếp / Quản trị viên (Ngăn cách bằng dấu phẩy nếu có nhiều ID)
# Lấy ID của bạn bằng cách nhắn tin cho bot @userinfobot trên Telegram
ADMIN_IDS=123456789,987654321

# 3. ID nhóm Telegram của công ty (Tùy chọn: để bot gửi báo cáo vào nhóm)
# Lấy Group ID bằng cách thêm @RawDataBot vào nhóm
MAIN_GROUP_ID=

# 4. Múi giờ hoạt động (Mặc định: Giờ Việt Nam GMT+7)
TIMEZONE=Asia/Ho_Chi_Minh

# 5. Đường dẫn lưu file Database SQLite
DATABASE_PATH=./data/company_bot.sqlite
